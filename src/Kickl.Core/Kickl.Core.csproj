<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ML-DSA PKCS#8 export is still marked experimental; the wire format is pinned by tests. -->
    <NoWarn>$(NoWarn);SYSLIB5006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CA root public key ships inside the build, so no device trusts a root it was merely shown. -->
    <EmbeddedResource Include="Trust\ca-root.json" LogicalName="ca-root.json" />
    <EmbeddedResource Include="Trust\shop-keys.json" LogicalName="shop-keys.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kickl.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

</Project>
