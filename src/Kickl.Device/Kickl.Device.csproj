<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kickl.Core\Kickl.Core.csproj" />
    <ProjectReference Include="..\Kickl.DongleReceiver\Kickl.DongleReceiver.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDongleReceiverRuntime" AfterTargets="Build">
    <ItemGroup>
      <DongleReceiverRuntime Include="..\Kickl.DongleReceiver\bin\$(Configuration)\net10.0\Kickl.DongleReceiver.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DongleReceiverRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
