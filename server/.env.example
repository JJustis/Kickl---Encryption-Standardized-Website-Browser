# Copy to server/.env (ignored by git) and edit.
KICKL_DB_HOST=127.0.0.1
KICKL_DB_PORT=3306
KICKL_DB_NAME=kickl_registry
KICKL_DB_USER=root
KICKL_DB_PASSWORD=

# Registration is disabled while this is empty. Use a long random value.
KICKL_ADMIN_TOKEN=

# Optional overrides.
# Only needed when the app is not directly at the web root and SCRIPT_NAME cannot be used.
# KICKL_BASE_PATH=/apicalls
# App directory when public/index.php is deployed away from src/ (deploy/apicalls sets this).
# KICKL_APP_ROOT=C:/kickl/server
# KICKL_KEYS_DIR=C:\path\to\registry-keys
# KICKL_DOTNET=dotnet
# KICKL_SIGNER_DLL=...\tools\Kickl.RegistrySigner\bin\Release\net10.0\Kickl.RegistrySigner.dll
